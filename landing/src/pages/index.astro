---
import Base from '../layouts/Base.astro';
import PhoneDemo from '../components/PhoneDemo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { closeImage, heroImage, showcase } from '../data/demo';

const petPolicy =
  'Well-behaved dogs and cats are welcome at stays that list pets as allowed, up to two per booking. There is a pet fee of $50 per pet per stay, which is added at checkout. Please tell your host before you arrive how many pets are coming.';

const [feature, tall, wideA, wideB, last] = showcase;
---

<Base
  title="Roam: describe a stay in one sentence"
  description="Say what you want in one sentence, like a quiet pet friendly cabin with a hot tub under $300 a night, and Roam returns ranked stays. Ask policy questions and get exact answers."
>
  <a
    href="#main"
    class="sr-only rounded-md bg-primary px-4 py-2 font-semibold text-on-primary focus:not-sr-only focus:absolute focus:left-5 focus:top-4 focus:z-50"
    >Skip to content</a
  >

  <main id="main">
    <!-- Hero: a dusk photograph carries the luxury, the phone proves the sentence -->
    <section class="relative isolate flex min-h-[100svh] flex-col overflow-hidden text-on-scrim">
      <img
        src={heroImage}
        alt="A modern villa with warm glowing windows at dusk, a garden lawn and a large tree in front"
        class="hero-img absolute inset-0 -z-20 size-full object-cover"
        fetchpriority="high"
      />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(11,11,26,0.88)_0%,rgba(11,11,26,0.65)_50%,rgba(11,11,26,0.2)_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-[#0b0b1a]/70 to-transparent"></div>

      <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-5">
        <a href="/" class="font-brand text-[2rem] leading-none" aria-label="Roam home">roam</a>
        <nav class="flex items-center gap-1 text-small font-medium sm:gap-2">
          <a href="#stays" class="hidden rounded-full px-3 py-2 hover:bg-white/10 sm:block">Stays</a>
          <a href="#how" class="rounded-full px-3 py-2 hover:bg-white/10">How it works</a>
          <a href="#host" class="rounded-full px-3 py-2 hover:bg-white/10">Host</a>
          <ThemeToggle />
        </nav>
      </header>

      <div class="mx-auto grid w-full max-w-6xl flex-1 items-center gap-12 px-5 pb-16 pt-6 lg:grid-cols-[1.1fr_1fr] lg:gap-8">
        <div>
          <h1 class="text-display">
            <span class="hero-line"><span style="--d: 150ms">Say the stay</span></span>
            <span class="hero-line"><span style="--d: 270ms">you want.</span></span>
          </h1>
          <p class="hero-fade mt-6 max-w-[36ch] text-lead text-white/85" style="--d: 650ms">
            One sentence, like “quiet pet friendly cabin with a hot tub under $300 a night”. Roam turns it into filters, ranks what is left, and hands back stays.
          </p>
          <a
            href="#how"
            class="hero-fade mt-9 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 text-[1.0625rem] font-semibold text-on-primary transition-transform hover:scale-[1.03] active:scale-[0.97]"
            style="--d: 800ms"
          >
            See how it works
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0-6-6m6 6 6-6" /></svg>
          </a>
        </div>
        <div class="text-ink [&_figcaption]:text-white/75">
          <PhoneDemo />
        </div>
      </div>
    </section>

    <!-- Gallery: the stays, large -->
    <section id="stays" class="scroll-mt-6 mx-auto max-w-6xl px-5 py-20 lg:py-28">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end" data-reveal>
        <h2 class="text-headline text-ink">Stays worth the sentence.</h2>
        <p class="max-w-[44ch] text-lead text-muted">
          Villas with infinity pools, glass-walled cabins, beach houses with the tide at the door. Every stay is hosted by the person who knows it best.
        </p>
      </div>

      <div class="mt-12 grid gap-3 md:grid-cols-12 md:gap-4">
        {
          [
            { s: feature, cls: 'md:col-span-7 aspect-[4/3] md:aspect-auto md:h-[34rem]' },
            { s: tall, cls: 'md:col-span-5 aspect-[4/3] md:aspect-auto md:h-[34rem]' },
            { s: wideA, cls: 'md:col-span-5 aspect-[4/3] md:aspect-auto md:h-[26rem]' },
            { s: wideB, cls: 'md:col-span-4 aspect-[4/3] md:aspect-auto md:h-[26rem]' },
            { s: last, cls: 'md:col-span-3 aspect-[4/3] md:aspect-auto md:h-[26rem]' },
          ].map(({ s, cls }, i) => (
            <figure class:list={['group relative isolate overflow-hidden rounded-lg', cls]} style={`border-curve: continuous; --d: ${(i % 2) * 120}ms`} data-reveal="photo">
              <img
                src={s.image}
                alt={`${s.title} in ${s.place}`}
                class="absolute inset-0 -z-10 size-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#0b0b1a]/90 via-[#0b0b1a]/40 via-45% to-transparent"></div>
              <figcaption class="absolute inset-x-0 bottom-0 p-5 text-on-scrim">
                <p class="text-title leading-tight">{s.title}</p>
                <p class="mt-1 text-small text-white/80">
                  {s.place} · ★ {s.rating} · <b class="font-semibold text-white">${s.price}</b> / night
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-4 text-small text-muted">Sample stays and photos from Roam's demo data.</p>
    </section>

    <!-- How it works: the mechanism, drawn on the sentence itself -->
    <section id="how" class="scroll-mt-6 bg-surface-alt py-20 lg:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div data-reveal>
          <h2 class="text-headline max-w-[22ch] text-ink">Exact things filter. Feelings rank.</h2>
        <p class="mt-5 max-w-[56ch] text-lead text-muted">
          Roam never guesses a price or a guest count. It reads those from your sentence, applies them as hard filters, and only then uses the feel of your words to order what is left.
        </p>
        </div>

        <p data-reveal class="mt-14 max-w-[26ch] text-[clamp(1.75rem,4.6vw,3.25rem)] font-bold leading-[1.3] tracking-[-0.02em] text-ink sm:max-w-[30ch]">
          <span class="mark [--mark:var(--color-secondary)] rounded-sm px-1.5 text-on-primary">quiet</span>
          <span class="mark mark-2 [--mark:var(--color-primary)] rounded-sm px-1.5 text-on-primary">pet friendly cabin with a hot tub under $300</span>
          a night
        </p>

        <dl class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-3">
          <div data-reveal>
            <dt class="flex items-center gap-2 text-title text-ink">
              <span class="size-3 rounded-full bg-primary" aria-hidden="true"></span>Filters
            </dt>
            <dd class="mt-2 max-w-[34ch] text-body text-muted">
              Price, guests, pets, place, stay type and amenities. A stay that misses one is out, never just ranked lower.
            </dd>
          </div>
          <div data-reveal style="--d: 120ms">
            <dt class="flex items-center gap-2 text-title text-ink">
              <span class="size-3 rounded-full bg-secondary" aria-hidden="true"></span>Ranking
            </dt>
            <dd class="mt-2 max-w-[34ch] text-body text-muted">
              Words like quiet, cozy and secluded are matched against each stay's own description. Best match comes first.
            </dd>
          </div>
          <div data-reveal style="--d: 240ms">
            <dt class="text-title text-ink">Say what you don't want</dt>
            <dd class="mt-2 max-w-[34ch] text-body text-muted">
              “No pets” is understood as a filter too, shown as a chip you can see.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Policy answers: exact words -->
    <section id="policies" class="scroll-mt-6 mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 lg:grid-cols-2 lg:gap-20 lg:py-28">
      <div data-reveal>
        <h2 class="text-headline text-ink">Ask about a policy. Read the policy.</h2>
        <p class="mt-5 max-w-[48ch] text-lead text-muted">
          On any stay you can ask about pets, cancellation, check-in or fees. Roam picks the matching entry from its own policies and shows it word for word. No model rewrites it, and if nothing answers, it says so and points you to support.
        </p>
      </div>

      <div class="rounded-lg bg-surface-alt p-5 sm:p-6" aria-label="Example policy question and answer">
        <div class="flex flex-wrap gap-2" aria-hidden="true" data-reveal>
          <span class="rounded-full bg-secondary-soft px-3 py-1.5 text-small font-medium text-ink">Pets</span>
          <span class="rounded-full bg-surface px-3 py-1.5 text-small font-medium text-ink">Cancellation</span>
          <span class="rounded-full bg-surface px-3 py-1.5 text-small font-medium text-ink">Check-in</span>
          <span class="rounded-full bg-surface px-3 py-1.5 text-small font-medium text-ink">Payments</span>
        </div>
        <p data-reveal style="--d: 350ms" class="mt-5 ml-auto w-fit max-w-[85%] rounded-md bg-primary px-4 py-3 text-body font-medium text-on-primary">
          Can I bring my dog?
        </p>
        <div data-reveal style="--d: 900ms" class="mt-3 rounded-md bg-surface p-5 shadow-card">
          <p class="text-body text-ink">{petPolicy}</p>
          <p class="mt-4 text-small font-medium text-secondary-strong">Pet policy · Roam policy</p>
        </div>
        <p class="mt-4 text-small text-muted">Sample question. The answer is the seeded text of Roam's pet policy.</p>
      </div>
    </section>

    <!-- Hosts: violet field with the estate photo -->
    <section id="host" class="scroll-mt-6 bg-secondary-soft py-20 lg:py-28">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2 lg:gap-16">
        <div data-reveal="photo" class="relative isolate overflow-hidden rounded-lg aspect-[4/5] lg:aspect-[5/6]" style="border-curve: continuous">
          <img src={tall.image} alt={`${tall.title} in ${tall.place}`} class="absolute inset-0 -z-10 size-full object-cover" loading="lazy" />
        </div>
        <div data-reveal style="--d: 150ms">
          <h2 class="text-headline text-ink">Have a place? Host it from the same app.</h2>
          <p class="mt-5 max-w-[46ch] text-lead text-muted">
            Anyone signed in can become a host from their profile. Add your stay, set the price, and guests searching by sentence can find it.
          </p>
          <ol class="mt-8 flex flex-col divide-y divide-border">
            <li data-reveal style="--d: 300ms" class="py-5 first:pt-0">
              <p class="text-title text-ink">Add the stay</p>
              <p class="mt-1 max-w-[42ch] text-body text-muted">Five to thirty photos, the basics, check-in and check-out times, and a few notes about how it feels.</p>
            </li>
            <li data-reveal style="--d: 420ms" class="py-5">
              <p class="text-title text-ink">We write the description from your facts</p>
              <p class="mt-1 max-w-[42ch] text-body text-muted">Copy is built only from what you entered and checked before it is published. Nothing invented.</p>
            </li>
            <li data-reveal style="--d: 540ms" class="py-5 last:pb-0">
              <p class="text-title text-ink">Keep your price current</p>
              <p class="mt-1 max-w-[42ch] text-body text-muted">Edit the nightly price and cleaning fee any time from the app.</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- Close: sunset photograph, one sentence -->
    <section class="relative isolate flex min-h-[32rem] items-end overflow-hidden text-on-scrim">
      <img src={closeImage} alt="Sunrise over a calm turquoise sea and a wide sandy beach" class="absolute inset-0 -z-20 size-full object-cover" loading="lazy" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#0b0b1a]/80 via-[#0b0b1a]/20 to-transparent"></div>
      <div class="mx-auto w-full max-w-6xl px-5 pb-16 pt-32 lg:pb-24">
        <h2 data-reveal class="text-display max-w-[14ch]">Tell Roam how it should feel.</h2>
        <p data-reveal style="--d: 250ms" class="mt-5 text-small text-white/80">Oceanfront Bungalow, Kailua-Kona, HI. Sample stay.</p>
      </div>
    </section>
  </main>

  <footer slot="footer" class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-10 text-small text-muted sm:flex-row sm:items-center sm:justify-between">
    <span class="font-brand text-[1.5rem] leading-none text-ink">roam</span>
    <p>Sample stays and photos on this page are demo content. © 2026 Roam</p>
  </footer>
</Base>
