---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // If the reveal script never starts, show everything rather than leave it hidden.
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove('js');
      }, 3000);
      try {
        var t = localStorage.getItem('roam-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen">
    <slot name="header" />
    <slot />
    <slot name="footer" />
    <script>
      // Reveal on scroll: each element enters once.
      (window as unknown as { __revealReady?: boolean }).__revealReady = true;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.18, rootMargin: '0px 0px -6% 0px' },
      );
      items.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
