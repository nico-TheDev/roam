---
import { scenes } from '../data/demo';
const first = scenes[0];
---

<figure class="mx-auto w-full max-w-[22rem]" data-demo data-scenes={JSON.stringify(scenes)}>
  <div class="phone-stage" data-tilt>
    <div class="iphone" data-phone>
      <span class="btn btn-action"></span>
      <span class="btn btn-vol-up"></span>
      <span class="btn btn-vol-down"></span>
      <span class="btn btn-power"></span>

      <div class="screen" aria-hidden="true">
        <!-- Status bar + Dynamic Island -->
        <div class="status">
          <span class="time">9:41</span>
          <span class="island"><i></i></span>
          <span class="sys">
            <svg viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5.5" width="3" height="6.5" rx="1" /><rect x="10" y="3" width="3" height="9" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
            <svg viewBox="0 0 17 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1.2 4.2a10 10 0 0 1 14.600 0M3.700 6.900a6.400 6.400 0 0 1 9.600 0M6.200 9.500a2.800 2.800 0 0 1 4.600 0" /></svg>
            <svg viewBox="0 0 27 13" fill="none"><rect x="0.5" y="0.5" width="22" height="12" rx="3.500" stroke="currentColor" opacity="0.4" /><rect x="2" y="2" width="19" height="9" rx="2" fill="currentColor" /><path d="M24 4.500v4c.9-.3 1.500-1.200 1.500-2s-.6-1.700-1.500-2z" fill="currentColor" opacity="0.5" /></svg>
          </span>
        </div>

        <div class="px-4 pt-2">
          <div class="flex items-center gap-2 rounded-full bg-surface-alt px-4 py-3">
            <svg class="size-5 shrink-0 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.500-3.500" /></svg>
            <p class="min-h-[2.5rem] flex-1 text-[0.9375rem] font-medium leading-5 text-ink" data-typed>
              <span data-typed-text>{first.sentence}</span><span class="demo-caret" data-caret></span>
            </p>
          </div>
          <div class="mt-3 flex min-h-[2.25rem] flex-wrap gap-2" data-chips>
            {
              first.chips.map((c) => (
                <span
                  class:list={[
                    'rounded-full px-3 py-1.5 text-small font-medium',
                    c.soft ? 'bg-secondary text-on-primary' : 'bg-secondary-soft text-ink',
                  ]}
                >
                  {c.label}
                </span>
              ))
            }
          </div>
        </div>

        <div class="mt-4 flex items-baseline justify-between px-4 text-small text-muted">
          <span data-count>{first.stays.length} stays</span>
          <span>Sort by <b class="font-bold text-ink">Best match</b></span>
        </div>

        <ul class="stay-list mt-2 flex flex-1 flex-col gap-1 overflow-hidden px-2" data-stays>
          {
            first.stays.map((s) => (
              <li class="flex gap-3 rounded-lg p-2">
                <img src={s.image} alt="" width="96" height="96" class="size-24 shrink-0 rounded-md object-cover" loading="eager" />
                <div class="min-w-0 flex-1">
                  <p class="text-[0.9375rem] font-bold leading-[1.2] text-ink">{s.title}</p>
                  <p class="mt-1 text-micro text-muted">{s.place}</p>
                  <p class="mt-1 flex items-center gap-1 text-small text-ink">
                    <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3 6.600 7.200.8-5.400 4.900 1.500 7.100L12 17.700 5.700 21.400l1.500-7.100L1.800 9.400 9 8.600z" /></svg>
                    <b class="font-semibold">{s.rating}</b>
                    <span class="text-muted">({s.reviews})</span>
                  </p>
                  <p class="mt-1 flex gap-1.5">
                    {s.badges.map((b) => (
                      <span class="rounded-full bg-surface-alt px-2 py-0.5 text-micro font-medium text-ink">{b}</span>
                    ))}
                  </p>
                  <p class="mt-1 text-[1.0625rem] font-bold text-ink">${s.price}<span class="text-small font-normal text-muted"> / night</span></p>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- Tab bar, as in the app -->
        <div class="tabbar">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8M5 10v10h14V10" /></svg>Home</span>
          <span class="on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.500-3.500" /></svg>Search</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>Trips</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>Profile</span>
        </div>
        <span class="home-indicator"></span>
        <span class="glare"></span>
      </div>
    </div>
  </div>
  <figcaption class="mt-5 text-center text-small text-muted">
    Sample stays from Roam's demo data. Search reads the sentence, then filters and ranks.
  </figcaption>
  <p class="sr-only">
    Example: typing "{first.sentence}" returns {first.stays.length} cabins, the first being {first.stays[0].title} at ${first.stays[0].price} a night.
  </p>
</figure>

<style>
  .phone-stage {
    perspective: 1400px;
  }
  .iphone {
    --tx: 0deg;
    --ty: 0deg;
    --gx: 30%;
    --gy: 10%;
    position: relative;
    padding: 0.4rem;
    border-radius: 3.4rem;
    /* Titanium band: a lit edge, a dark core */
    background:
      linear-gradient(135deg, #8d8d96 0%, #3b3b42 18%, #1b1b20 45%, #2f2f36 70%, #6f6f78 100%);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.28),
      inset 0 0 0 4px #0a0a0d,
      0 40px 70px -28px rgba(11, 11, 26, 0.6),
      0 10px 24px rgba(11, 11, 26, 0.25);
    transform: rotateX(var(--tx)) rotateY(var(--ty));
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    animation: phone-in 1100ms cubic-bezier(0.16, 1, 0.3, 1) 350ms both;
  }
  .btn {
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #55555d, #26262b);
  }
  .btn-action { left: -3px; top: 7.2rem; height: 1.8rem; }
  .btn-vol-up { left: -3px; top: 10.2rem; height: 3.2rem; }
  .btn-vol-down { left: -3px; top: 14.2rem; height: 3.2rem; }
  .btn-power { right: -3px; top: 11.5rem; height: 5.2rem; background: linear-gradient(270deg, #55555d, #26262b); }

  .screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 43rem;
    overflow: hidden;
    border-radius: 3rem;
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 0 0 3px #000;
    border-curve: continuous;
  }
  .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.4rem;
    padding: 0.6rem 1.9rem 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .island {
    position: absolute;
    left: 50%;
    top: 0.7rem;
    width: 6.6rem;
    height: 1.9rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
  }
  .island i {
    position: absolute;
    right: 0.7rem;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3a5c, #0a0f1c 70%);
  }
  .sys {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .sys svg:nth-child(1) { height: 0.7rem; }
  .sys svg:nth-child(2) { height: 0.7rem; }
  .sys svg:nth-child(3) { height: 0.8rem; }

  /* Cards run out under the tab bar, fading rather than cutting. */
  .stay-list {
    margin-bottom: 5.6rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }
  .tabbar {
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--color-glass, rgba(255, 255, 255, 0.7));
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 6px 20px rgba(11, 11, 26, 0.14), inset 0 0 0 1px var(--color-border);
  }
  .tabbar span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.4rem 0;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .tabbar svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .tabbar .on {
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 600;
  }
  .home-indicator {
    position: absolute;
    left: 50%;
    bottom: 0.45rem;
    width: 8.4rem;
    height: 5px;
    transform: translateX(-50%);
    border-radius: 3px;
    background: var(--color-ink);
    opacity: 0.85;
  }
  /* Screen glass: a fixed sheen plus a highlight that trails the pointer */
  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--gx) var(--gy), rgba(255, 255, 255, 0.22), transparent 42%),
      linear-gradient(115deg, rgba(255, 255, 255, 0.1) 0%, transparent 30%);
    mix-blend-mode: soft-light;
    transition: background-position 200ms;
  }

  .demo-caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--color-ink);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret {
    50% {
      opacity: 0;
    }
  }
  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translateY(36px) rotateX(8deg) scale(0.97);
    }
  }
  :global(.demo-in) {
    animation: demo-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes demo-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iphone {
      animation: none;
      transition: none;
      transform: none;
    }
    .demo-caret {
      animation: none;
    }
    :global(.demo-in) {
      animation: none;
    }
  }
</style>

<script>
  type Scene = {
    sentence: string;
    chips: { label: string; soft?: boolean }[];
    stays: { title: string; place: string; rating: string; reviews: number; price: number; image: string; badges: string[] }[];
  };

  const root = document.querySelector<HTMLElement>('[data-demo]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduce) {
    const scenes: Scene[] = JSON.parse(root.dataset.scenes ?? '[]');
    const text = root.querySelector<HTMLElement>('[data-typed-text]')!;
    const chips = root.querySelector<HTMLElement>('[data-chips]')!;
    const list = root.querySelector<HTMLElement>('[data-stays]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    const chipHtml = (c: Scene['chips'][number], i: number) =>
      `<span class="demo-in rounded-full px-3 py-1.5 text-small font-medium ${c.soft ? 'bg-secondary text-on-primary' : 'bg-secondary-soft text-ink'}" style="--d:${i * 70}ms">${esc(c.label)}</span>`;

    const stayHtml = (s: Scene['stays'][number], i: number) => `
      <li class="demo-in flex gap-3 rounded-lg p-2" style="--d:${i * 110}ms">
        <img src="${esc(s.image)}" alt="" width="96" height="96" class="size-24 shrink-0 rounded-md object-cover" />
        <div class="min-w-0 flex-1">
          <p class="text-[0.9375rem] font-bold leading-[1.2] text-ink">${esc(s.title)}</p>
          <p class="mt-1 text-micro text-muted">${esc(s.place)}</p>
          <p class="mt-1 flex items-center gap-1 text-small text-ink">
            <svg class="size-3.5 text-primary" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 3 6.6 7.2.8-5.4 4.9 1.5 7.1L12 17.7 5.7 21.4l1.5-7.1L1.8 9.4 9 8.6z"/></svg>
            <b class="font-semibold">${esc(s.rating)}</b><span class="text-muted">(${s.reviews})</span>
          </p>
          <p class="mt-1 flex gap-1.5">${s.badges.map((b) => `<span class="rounded-full bg-surface-alt px-2 py-0.5 text-micro font-medium text-ink">${esc(b)}</span>`).join('')}</p>
          <p class="mt-1 text-[1.0625rem] font-bold text-ink">$${s.price}<span class="text-small font-normal text-muted"> / night</span></p>
        </div>
      </li>`;

    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

    const run = async () => {
      let i = 0;
      await sleep(5000);
      while (true) {
        i = (i + 1) % scenes.length;
        const scene = scenes[i];
        while (!visible) await sleep(500);
        // erase
        chips.innerHTML = '';
        list.innerHTML = '';
        count.textContent = '';
        while (text.textContent) {
          text.textContent = text.textContent.slice(0, -3);
          await sleep(14);
        }
        await sleep(250);
        // type
        for (let n = 1; n <= scene.sentence.length; n++) {
          text.textContent = scene.sentence.slice(0, n);
          await sleep(34 + Math.random() * 28);
        }
        await sleep(350);
        chips.innerHTML = scene.chips.map(chipHtml).join('');
        await sleep(450);
        count.textContent = `${scene.stays.length} stays`;
        list.innerHTML = scene.stays.map(stayHtml).join('');
        await sleep(5200);
      }
    };
    run();
  }
</script>

<script>
  // Pointer tilt: the phone turns a few degrees toward the cursor and the glass catches light.
  const stage = document.querySelector<HTMLElement>('[data-tilt]');
  const phone = document.querySelector<HTMLElement>('[data-phone]');
  const hero = stage?.closest('section');
  const canTilt = window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches;
  if (stage && phone && hero && canTilt) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = stage.getBoundingClientRect();
        const x = Math.max(-1, Math.min(1, (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2)));
        const y = Math.max(-1, Math.min(1, (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2)));
        phone.style.setProperty('--ty', `${(x * 7).toFixed(2)}deg`);
        phone.style.setProperty('--tx', `${(-y * 5).toFixed(2)}deg`);
        phone.style.setProperty('--gx', `${(50 + x * 40).toFixed(1)}%`);
        phone.style.setProperty('--gy', `${(30 + y * 30).toFixed(1)}%`);
      });
    });
    hero.addEventListener('pointerleave', () => {
      phone.style.setProperty('--ty', '0deg');
      phone.style.setProperty('--tx', '0deg');
    });
  }
</script>
